  "files":[
    {"$GMExtensionFile":"","%Name":"TigerCrashReporter.gml","constants":[],"copyToTargets":-1,"filename":"TigerCrashReporter.gml","final":"","functions":[
        {"$GMExtensionFunction":"","%Name":"tiger_set_server","argCount":1,"args":[1,],"documentation":"Set the server URL for crash reporting","externalName":"tiger_set_server","help":"tiger_set_server(url)\nSet the server URL for crash reporting\n\nArguments:\n  url (string): The server URL (must include http:// or https://)\n\nReturns:\n  bool: true if successful, false if invalid URL","hidden":false,"kind":2,"name":"tiger_set_server","resourceType":"GMExtensionFunction","resourceVersion":"2.0","returnType":1,},
